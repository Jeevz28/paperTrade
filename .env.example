# Only trading input: initial capital, used once for the default NIFTY F&O account.
PAPER_INITIAL_CAPITAL=5000
# Existing accounts retain capital, positions and loss history across restarts.
PAPERLAB_DB=data/trading.db
PAPERLAB_MODE=education
# Set licensed_private for recent/live data you are authorized to use.
# Reference records your data-use basis; it is not an Upstox credential.
DATA_PERMISSION_REFERENCE=
UPSTOX_ENABLED=false
UPSTOX_ACCESS_TOKEN=

# Railway: set these as service Variables, never commit a populated .env.
# Railway is detected automatically; local desktop mode remains the default.
PAPERLAB_HOSTED=false
PAPERLAB_PUBLIC_URL=https://papertrade-production-5108.up.railway.app/
PAPERLAB_USERNAME=Jeevz
PAPERLAB_PASSWORD=Alohomora@2104
# On Railway mount a volume at /data and set PAPERLAB_DB=/data/trading.db.
# Password must be at least 16 characters. Prefer a random password manager value.
# PUBLIC_URL can be blank when RAILWAY_PUBLIC_DOMAIN is available.
